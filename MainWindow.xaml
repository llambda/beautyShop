<Window x:Class="BeautyStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BeautyStudio.Views"
        xmlns:vm="clr-namespace:BeautyStudio.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Beauty Studio"
        Height="800"
        Width="1400"
        MinHeight="600"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesign.Brush.Background}">

    <!-- TEMPLATE DELLE SCHERMATE -->

    <Window.Resources>

        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <views:CustomerListView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CalendarViewModel}">
            <views:CalendarView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:UpcomingInterventionsViewModel}">
            <views:UpcomingInterventionsView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CustomerDetailsViewModel}">
            <views:CustomerDetailsView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:InterventionEditorViewModel}">
            <views:InterventionEditorView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AppointmentEditorViewModel}">
            <views:AppointmentEditorView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>

    </Window.Resources>


    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding MenuWidth}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- ====================================== -->
        <!-- MENU SINISTRO                          -->
        <!-- ====================================== -->

        <Border Grid.Column="0"
                Background="{DynamicResource MaterialDesign.Brush.Surface}"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}"
                BorderThickness="0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="110"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="55"/>
                </Grid.RowDefinitions>


                <!-- LOGO -->

                <StackPanel Grid.Row="0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <materialDesign:PackIcon
                        Kind="FlowerTulip"
                        Width="38"
                        Height="38"
                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                        HorizontalAlignment="Center"/>

                    <TextBlock Text="BEAUTY STUDIO"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                               Margin="0,5,0,0"
                               Visibility="{Binding IsMenuExpanded,
                               Converter={StaticResource BoolToVisibilityConverter}}"/>

                </StackPanel>


                <!-- NAVIGAZIONE -->

                <StackPanel Grid.Row="1"
                            Margin="8,15">

                    <!-- PANORAMICA -->
                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Panoramica"
                            Height="48" HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ViewDashboard" Width="24" Height="24"/>
                            <TextBlock Text="Panoramica" Margin="15,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding IsMenuExpanded, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Button>

                    <!-- CLIENTI -->

                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Clienti"
                            Height="48"
                            HorizontalContentAlignment="Center">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon
                                Kind="AccountMultiple"
                                Width="24"
                                Height="24"/>

                            <TextBlock Text="Clienti"
                                       Margin="15,0,0,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsMenuExpanded,
                                       Converter={StaticResource BoolToVisibilityConverter}}"/>

                        </StackPanel>

                    </Button>


                    <!-- CALENDARIO -->

                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Appuntamenti"
                            Height="48"
                            HorizontalContentAlignment="Center">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon
                                Kind="CalendarMonth"
                                Width="24"
                                Height="24"/>

                            <TextBlock Text="Appuntamenti"
                                       Margin="15,0,0,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsMenuExpanded,
                                       Converter={StaticResource BoolToVisibilityConverter}}"/>

                        </StackPanel>

                    </Button>


                    <!-- INTERVENTI -->

                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Interventi"
                            Height="48"
                            HorizontalContentAlignment="Center">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon
                                Kind="ClipboardList"
                                Width="24"
                                Height="24"/>

                            <TextBlock Text="Interventi"
                                       Margin="15,0,0,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsMenuExpanded,
                                       Converter={StaticResource BoolToVisibilityConverter}}"/>

                        </StackPanel>

                    </Button>

                    <!-- IMPOSTAZIONI -->
                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Impostazioni"
                            Height="48"
                            HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Cog" Width="24" Height="24"/>
                            <TextBlock Text="Impostazioni" Margin="15,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding IsMenuExpanded, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Button>

                </StackPanel>


                <!-- COMPRESSIONE MENU -->

                <Button Grid.Row="2"
                        Command="{Binding ToggleMenuCommand}"
                        Style="{StaticResource MaterialDesignToolButton}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="40"
                        Height="40">

                    <materialDesign:PackIcon
                        Width="22"
                        Height="22">

                        <materialDesign:PackIcon.Style>

                            <Style TargetType="materialDesign:PackIcon">

                                <Setter Property="Kind"
                                        Value="ChevronLeft"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsMenuExpanded}"
                                                 Value="False">

                                        <Setter Property="Kind"
                                                Value="ChevronRight"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </materialDesign:PackIcon.Style>

                    </materialDesign:PackIcon>

                </Button>

            </Grid>

        </Border>


        <!-- ====================================== -->
        <!-- AREA PRINCIPALE                        -->
        <!-- ====================================== -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- HEADER -->

            <Border Grid.Row="0"
                    Background="{DynamicResource MaterialDesign.Brush.Surface}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}"
                    BorderThickness="0,0,0,1">

                <Button HorizontalAlignment="Right"
                        Margin="0"
                        Width="36"
                        Height="36"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Impostazioni"
                        ToolTip="Impostazioni"
                        Style="{StaticResource MaterialDesignToolButton}">

                    <materialDesign:PackIcon
                        Kind="Cog"
                        Width="20"
                        Height="20"/>

                </Button>

            </Border>


            <!-- CONTENUTO DINAMICO -->

            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentViewModel}"
                            Margin="10"/>

        </Grid>

    </Grid>

</Window>
