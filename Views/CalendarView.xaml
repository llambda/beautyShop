<UserControl x:Class="BeautyStudio.Views.CalendarView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
 Background="#F7F5F6">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="0,0,0,18">
   <TextBlock Text="Appuntamenti" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
   <TextBlock Text="Calendario e agenda giornaliera degli appuntamenti" FontSize="13" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" Margin="0,5,0,0"/>
   <TextBlock Text="{Binding ReminderMessage}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" Margin="0,6,0,0"/>
  </StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal">
    <Button Command="{Binding PreviousMonthCommand}" Style="{StaticResource MaterialDesignToolButton}" Width="40" Height="40"><materialDesign:PackIcon Kind="ChevronLeft" Width="22" Height="22"/></Button>
    <Button Command="{Binding TodayCommand}" Content="Oggi" Margin="5,0" Padding="12,8" MinHeight="38"/>
    <Button Command="{Binding NextMonthCommand}" Style="{StaticResource MaterialDesignToolButton}" Width="40" Height="40"><materialDesign:PackIcon Kind="ChevronRight" Width="22" Height="22"/></Button>
   </StackPanel>
   <TextBlock Grid.Column="1" Text="{Binding MonthTitle}" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   <StackPanel Grid.Column="2" Orientation="Horizontal">
    <Button Content="PDF" Command="{Binding ExportMonthPdfCommand}" Padding="10,8" Margin="0,0,5,0" ToolTip="Esporta il mese in PDF" MinHeight="38"/>
    <Button Content="CSV" Command="{Binding ExportMonthCsvCommand}" Padding="10,8" Margin="0,0,5,0" ToolTip="Esporta il mese in CSV" MinHeight="38"/>
    <Button Command="{Binding RefreshCommand}" Style="{StaticResource MaterialDesignToolButton}" ToolTip="Aggiorna calendario" Width="40" Height="40"><materialDesign:PackIcon Kind="Refresh" Width="20" Height="20"/></Button>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="6" Margin="0,0,12,0">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <UniformGrid Grid.Row="0" Columns="7">
      <TextBlock Text="Lunedì" HorizontalAlignment="Center" FontWeight="SemiBold"/><TextBlock Text="Martedì" HorizontalAlignment="Center" FontWeight="SemiBold"/><TextBlock Text="Mercoledì" HorizontalAlignment="Center" FontWeight="SemiBold"/><TextBlock Text="Giovedì" HorizontalAlignment="Center" FontWeight="SemiBold"/><TextBlock Text="Venerdì" HorizontalAlignment="Center" FontWeight="SemiBold"/><TextBlock Text="Sabato" HorizontalAlignment="Center" FontWeight="SemiBold"/><TextBlock Text="Domenica" HorizontalAlignment="Center" FontWeight="SemiBold"/>
     </UniformGrid>
     <ItemsControl Grid.Row="1" ItemsSource="{Binding Days}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" Rows="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <Button Padding="0" Margin="0" MinHeight="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                Command="{Binding DataContext.SelectDateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding Date}" ToolTip="Seleziona questo giorno">
         <Border BorderBrush="#E8E2E6" BorderThickness="0,1,1,0" Padding="4" MinHeight="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
          <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Surface}"/><Style.Triggers>
           <DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="Background" Value="#FFF3F7"/></DataTrigger>
           <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="#F1DCE7"/><Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}"/><Setter Property="BorderThickness" Value="2"/></DataTrigger>
          </Style.Triggers></Style></Border.Style>
         <Grid>
           <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
           <TextBlock Text="{Binding DayNumber}" FontWeight="SemiBold" HorizontalAlignment="Left">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}"/><Style.Triggers><DataTrigger Binding="{Binding IsCurrentMonth}" Value="False"><Setter Property="Foreground" Value="#B8AFB4"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
           </TextBlock>
           <StackPanel Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" Orientation="Horizontal">
            <TextBlock Text="{Binding Appointments.Count, StringFormat={}{0} appuntamenti}" FontSize="9" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" TextTrimming="CharacterEllipsis"/>
           </StackPanel>
          </Grid>
         </Grid>
         </Border>
        </Button>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
    </Grid>
   </Border>
   <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="16">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Grid.Row="0">
      <TextBlock Text="{Binding AgendaTitle}" FontSize="21" FontWeight="SemiBold"/>
      <TextBlock Text="Seleziona una data per consultare gli appuntamenti e aprire la scheda cliente." Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" TextWrapping="Wrap" Margin="0,5,0,10"/>
     </StackPanel>
     <DatePicker Grid.Row="1" SelectedDate="{Binding SelectedAgendaDate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
     <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding DailyAppointments}">
       <ItemsControl.ItemTemplate><DataTemplate>
        <Border BorderBrush="#E8E2E6" BorderThickness="0,0,0,1" Padding="0,10">
         <StackPanel>
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock Text="{Binding Date, StringFormat='{}{0:HH:mm}'}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
           <Button Grid.Column="1" Command="{Binding DataContext.OpenCustomerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="9,5" MinHeight="34" ToolTip="Apri la scheda cliente">
            <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Account" Width="17" Height="17"/><TextBlock Text="Cliente" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel>
           </Button>
          </Grid>
          <TextBlock FontWeight="SemiBold" Margin="0,3,0,0"><Run Text="{Binding Customer.FirstName}"/><Run Text=" "/><Run Text="{Binding Customer.LastName}"/></TextBlock>
          <TextBlock Text="{Binding InterventionType.Name, TargetNullValue='Tipo non specificato'}" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" Margin="0,2,0,0"/>
          <TextBlock Text="{Binding Location.Name, TargetNullValue='Luogo non specificato'}" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"/>
          <TextBlock Text="{Binding DurationMinutes, StringFormat='Durata: {0} minuti'}" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"/>
          <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" Margin="0,3,0,0"/>
          <TextBlock Text="{Binding WorkingHoursWarning}" Foreground="#B3261E" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0">
           <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsOutsideWorkingHours}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <TextBlock Text="Attenzione: appuntamento sovrapposto a un altro." Foreground="#B3261E" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0">
           <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasOverlapWarning}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding Notes, TargetNullValue=''}" TextWrapping="Wrap" Margin="0,3,0,0"/>
         </StackPanel>
        </Border>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </ScrollViewer>
     <TextBlock Grid.Row="2" Text="Nessun appuntamento per questa data." Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" VerticalAlignment="Top" Margin="0,12,0,0">
      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DailyAppointments.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>