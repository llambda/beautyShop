<UserControl x:Class="BeautyStudio.Views.CalendarView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
 Background="#F7F5F6">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="0,0,0,18">
   <TextBlock Text="Appuntamenti" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
   <TextBlock Text="Calendario degli appuntamenti dei clienti" FontSize="13" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" Margin="0,5,0,0"/>
   <TextBlock Text="{Binding ReminderMessage}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" Margin="0,6,0,0"/>
  </StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal">
    <Button Command="{Binding PreviousMonthCommand}" Style="{StaticResource MaterialDesignToolButton}" Width="40" Height="40"><materialDesign:PackIcon Kind="ChevronLeft" Width="22" Height="22"/></Button>
    <Button Command="{Binding TodayCommand}" Content="Oggi" Margin="5,0" Padding="12,8" MinHeight="38"/>
    <Button Command="{Binding NextMonthCommand}" Style="{StaticResource MaterialDesignToolButton}" Width="40" Height="40"><materialDesign:PackIcon Kind="ChevronRight" Width="22" Height="22"/></Button>
   </StackPanel>
   <TextBlock Grid.Column="1" Text="{Binding MonthTitle}" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   <StackPanel Grid.Column="2" Orientation="Horizontal">
    <Button Content="PDF" Command="{Binding ExportMonthPdfCommand}" Padding="10,8" Margin="0,0,5,0" ToolTip="Esporta il mese in PDF" MinHeight="38"/>
    <Button Content="CSV" Command="{Binding ExportMonthCsvCommand}" Padding="10,8" Margin="0,0,5,0" ToolTip="Esporta il mese in CSV" MinHeight="38"/>
    <Button Command="{Binding RefreshCommand}" Style="{StaticResource MaterialDesignToolButton}" ToolTip="Aggiorna calendario" Width="40" Height="40"><materialDesign:PackIcon Kind="Refresh" Width="20" Height="20"/></Button>
   </StackPanel>
  </Grid>
  <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="10">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <UniformGrid Grid.Row="0" Columns="7">
     <TextBlock Text="Lunedì" HorizontalAlignment="Center" FontWeight="SemiBold"/><TextBlock Text="Martedì" HorizontalAlignment="Center" FontWeight="SemiBold"/><TextBlock Text="Mercoledì" HorizontalAlignment="Center" FontWeight="SemiBold"/><TextBlock Text="Giovedì" HorizontalAlignment="Center" FontWeight="SemiBold"/><TextBlock Text="Venerdì" HorizontalAlignment="Center" FontWeight="SemiBold"/><TextBlock Text="Sabato" HorizontalAlignment="Center" FontWeight="SemiBold"/><TextBlock Text="Domenica" HorizontalAlignment="Center" FontWeight="SemiBold"/>
    </UniformGrid>
    <ItemsControl Grid.Row="1" ItemsSource="{Binding Days}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" Rows="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <Border BorderBrush="#E8E2E6" BorderThickness="0,1,1,0" Padding="5" MinHeight="88">
        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Surface}"/><Style.Triggers><DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="Background" Value="#FFF3F7"/></DataTrigger></Style.Triggers></Style></Border.Style>
        <Grid>
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
         <TextBlock Text="{Binding DayNumber}" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}"/><Style.Triggers><DataTrigger Binding="{Binding IsCurrentMonth}" Value="False"><Setter Property="Foreground" Value="#B8AFB4"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
         <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Appointments}">
           <ItemsControl.ItemTemplate><DataTemplate>
            <Border Background="#F4EAF0" CornerRadius="5" Padding="4" Margin="0,3,0,0">
             <StackPanel>
              <TextBlock Text="{Binding Time}" FontSize="10" FontWeight="Bold" Foreground="#8D4268"/>
              <TextBlock Text="{Binding CustomerName}" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding InterventionType}" FontSize="9" Foreground="#725E69" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" TextWrapping="Wrap"/>
             </StackPanel>
            </Border>
           </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
         </ScrollViewer>
        </Grid>
       </Border>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
   </Grid>
  </Border>
 </Grid>
</UserControl>