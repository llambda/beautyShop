<UserControl x:Class="BeautyStudio.Views.CustomerDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#F7F5F6"
             UseLayoutRounding="True">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Grid Grid.Row="0" Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <Button Command="{Binding BackToCustomersCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        HorizontalAlignment="Left"
                        Padding="5,5">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Kind="ArrowLeft"
                            Width="20"
                            Height="20"/>

                        <TextBlock Text="Torna ai clienti"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

                <TextBlock Text="Scheda cliente"
                           FontSize="27"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                           Margin="0,10,0,0"/>

            </StackPanel>

        </Grid>

        <!-- CONTENUTO -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>

                <!-- PROFILO CLIENTE -->

                <Border Background="White"
                        CornerRadius="15"
                        Padding="20"
                        Margin="0,0,0,18">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- FOTO -->

                        <Border Grid.Column="0"
                                Width="140"
                                Height="160"
                                CornerRadius="12"
                                Background="#F3E8ED"
                                ClipToBounds="True">

                            <Grid>

                                <Image Source="{Binding Customer.PhotoPath}"
                                       Stretch="UniformToFill"/>

                                <materialDesign:PackIcon
                                    Kind="Account"
                                    Width="45"
                                    Height="45"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"/>

                            </Grid>

                        </Border>

                        <!-- NOME E COGNOME -->

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="15,0,0,0">

                            <TextBlock
                                Text="{Binding Customer.FirstName}"
                                FontSize="25"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>

                            <TextBlock
                                Text="{Binding Customer.LastName}"
                                FontSize="25"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>

                            <TextBlock
                                Text="{Binding Customer.BirthDate,
                                StringFormat='Nata il {0:dd/MM/yyyy}'}"
                                Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                                FontSize="13"
                                Margin="0,8,0,0"/>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- SEZIONE ANAGRAFICA -->

                <Border Background="White"
                        CornerRadius="15"
                        Padding="22"
                        Margin="0,0,0,18">

                    <StackPanel>

                        <TextBlock Text="Anagrafica"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                   Margin="0,0,0,20"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- TELEFONO -->

                            <StackPanel Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,15,20">

                                <TextBlock Text="Telefono"
                                           Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                                           FontSize="12"/>

                                <TextBlock
                                    Text="{Binding Customer.Phone,
                                    TargetNullValue='Non specificato'}"
                                    FontSize="15"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                    Margin="0,5,0,0"/>

                            </StackPanel>

                            <!-- EMAIL -->

                            <StackPanel Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="0,0,0,20">

                                <TextBlock Text="Email"
                                           Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                                           FontSize="12"/>

                                <TextBlock
                                    Text="{Binding Customer.Email,
                                    TargetNullValue='Non specificata'}"
                                    FontSize="15"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                    Margin="0,5,0,0"
                                    TextWrapping="Wrap"/>

                            </StackPanel>

                            <!-- INDIRIZZO -->

                            <StackPanel Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Margin="0,0,0,20">

                                <TextBlock Text="Indirizzo"
                                           Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                                           FontSize="12"/>

                                <TextBlock
                                    Text="{Binding Customer.Address,
                                    TargetNullValue='Non specificato'}"
                                    FontSize="15"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                    Margin="0,5,0,0"
                                    TextWrapping="Wrap"/>

                            </StackPanel>

                            <!-- DATA REGISTRAZIONE -->

                            <StackPanel Grid.Row="2"
                                        Grid.Column="0">

                                <TextBlock Text="Cliente dal"
                                           Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                                           FontSize="12"/>

                                <TextBlock
                                    Text="{Binding Customer.CreatedAt,
                                    StringFormat='{}{0:dd/MM/yyyy}'}"
                                    FontSize="15"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                    Margin="0,5,0,0"/>

                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- NOTE -->

                <Border Background="White"
                        CornerRadius="15"
                        Padding="22"
                        Margin="0,0,0,18">

                    <StackPanel>

                        <TextBlock Text="Note cliente"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                   Margin="0,0,0,12"/>

                        <TextBlock
                            Text="{Binding Customer.Notes,
                            TargetNullValue='Nessuna nota disponibile'}"
                            FontSize="14"
                            Foreground="#777077"
                            TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>


                <!-- INTERVENTI -->

                <Border Background="White"
                        CornerRadius="15"
                        Padding="22"
                        Margin="0,0,0,18">

                    <StackPanel>

                        <TextBlock Text="Interventi"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>

                        <TextBlock
                            Text="Qui verrà visualizzato lo storico dei trattamenti della cliente."
                            Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                            Margin="0,10,0,15"
                            TextWrapping="Wrap"/>

                        <Button Content="Nuovo intervento"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                Foreground="White"
                                BorderThickness="0"
                                Padding="18,10"
                                IsEnabled="False"
                                Height="40"/>

                    </StackPanel>

                </Border>


                <!-- GALLERIA -->

                <Border Background="White"
                        CornerRadius="15"
                        Padding="22"
                        Margin="0,0,0,18">

                    <StackPanel>

                        <TextBlock Text="Galleria fotografica"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>

                        <TextBlock
                            Text="Le fotografie prima e dopo saranno associate ai singoli interventi."
                            Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                            Margin="0,10,0,0"
                            TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>


                <!-- APPUNTAMENTI -->

                <Border Background="White"
                        CornerRadius="15"
                        Padding="22"
                        Margin="0,0,0,18">

                    <StackPanel>

                        <TextBlock Text="Appuntamenti"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>

                        <TextBlock
                            Text="Qui verranno visualizzati gli appuntamenti della cliente."
                            Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                            Margin="0,10,0,0"
                            TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>
