<UserControl x:Class="BeautyStudio.Views.CustomerDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#F7F5F6" UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <Button Command="{Binding BackToCustomersCommand}" Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Left" Padding="5,5">
                <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ArrowLeft" Width="20" Height="20"/><TextBlock Text="Torna ai clienti" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
            </Button>
            <TextBlock Text="Scheda cliente" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,10,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Background="White" CornerRadius="15" Padding="20" Margin="0,0,0,18">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="140" Height="160" CornerRadius="12" Background="#F3E8ED" ClipToBounds="True">
                            <Image Source="{Binding Customer.PhotoPath}" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                            <TextBlock Text="{Binding Customer.FirstName}" FontSize="25" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Customer.LastName}" FontSize="25" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Customer.BirthDate, StringFormat='Nata il {0:dd/MM/yyyy}'}" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" FontSize="13" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Background="White" CornerRadius="15" Padding="22" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Anagrafica" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,15,20"><TextBlock Text="Telefono" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" FontSize="12"/><TextBlock Text="{Binding Customer.Phone, TargetNullValue='Non specificato'}" FontSize="15" Margin="0,5,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,0,20"><TextBlock Text="Email" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" FontSize="12"/><TextBlock Text="{Binding Customer.Email, TargetNullValue='Non specificata'}" FontSize="15" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,20"><TextBlock Text="Indirizzo" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" FontSize="12"/><TextBlock Text="{Binding Customer.Address, TargetNullValue='Non specificato'}" FontSize="15" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
                            <StackPanel Grid.Row="2"><TextBlock Text="Cliente dal" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" FontSize="12"/><TextBlock Text="{Binding Customer.CreatedAt, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="15" Margin="0,5,0,0"/></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="15" Padding="22" Margin="0,0,0,18">
                    <StackPanel><TextBlock Text="Note cliente" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="{Binding Customer.Notes, TargetNullValue='Nessuna nota disponibile'}" FontSize="14" Foreground="#777077" TextWrapping="Wrap"/></StackPanel>
                </Border>
                <Border Background="White" CornerRadius="15" Padding="22" Margin="0,0,0,18">
                    <StackPanel>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Interventi" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Command="{Binding NewInterventionCommand}" Click="NewIntervention_Click" ToolTip="Nuovo intervento" Style="{StaticResource MaterialDesignToolButton}" Width="40" Height="40"><materialDesign:PackIcon Kind="Plus" Width="22" Height="22"/></Button>
                                <Button Command="{Binding EditInterventionCommand}" CommandParameter="{Binding SelectedIntervention}" x:Name="EditInterventionButton" IsEnabled="False" ToolTip="Modifica intervento selezionato" Style="{StaticResource MaterialDesignToolButton}" Width="40" Height="40"><materialDesign:PackIcon Kind="Pencil" Width="20" Height="20"/></Button>
                                <Button Command="{Binding DeleteInterventionCommand}" x:Name="DeleteInterventionButton" IsEnabled="False" ToolTip="Elimina intervento selezionato" Style="{StaticResource MaterialDesignToolButton}" Width="40" Height="40"><materialDesign:PackIcon Kind="Delete" Width="20" Height="20"/></Button>
                            </StackPanel>
                        </Grid>
                        <DataGrid ItemsSource="{Binding Interventions}" SelectedItem="{Binding SelectedIntervention}" SelectionChanged="Interventions_SelectionChanged" AutoGenerateColumns="False"
                                  Background="{DynamicResource MaterialDesign.Brush.Surface}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                  CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" MinHeight="130" MaxHeight="240" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Data" Binding="{Binding Date, StringFormat='{}{0:dd/MM/yyyy}'}" Width="Auto"/>
                                <DataGridTextColumn Header="Tipo" Binding="{Binding Type.Name}" Width="*"/>
                                <DataGridTextColumn Header="Luogo" Binding="{Binding Location.Name}" Width="*"/>
                                <DataGridTextColumn Header="Note" Binding="{Binding Notes}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        
                    </StackPanel>
                </Border>
                <Border x:Name="InterventionDetailsPanel" Visibility="Collapsed" Background="White" CornerRadius="15" Padding="22" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Dettagli intervento" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,15"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,12"><TextBlock Text="Data" Margin="0,0,0,5"/><DatePicker SelectedDate="{Binding InterventionDate}"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,12"><TextBlock Text="Luogo" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}" DisplayMemberPath="Name"/></StackPanel>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2"><TextBlock Text="Tipo di intervento" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" DisplayMemberPath="Name"/></StackPanel>
                        </Grid>
                        <TextBlock Text="Note" Margin="0,12,0,5"/><TextBox Text="{Binding InterventionNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" Padding="8"/>
                        <TextBlock Text="Foto prima" FontWeight="SemiBold" Margin="0,16,0,7"/><Button Content="Aggiungi foto prima" Command="{Binding AddBeforePhotosCommand}" HorizontalAlignment="Left" Padding="12,6"/>
                        <ItemsControl ItemsSource="{Binding BeforePhotos}" Margin="0,8,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,8,8"><StackPanel><Image Source="{Binding}" Width="100" Height="85" Stretch="UniformToFill"/><Button Content="Rimuovi" Command="{Binding DataContext.RemoveBeforePhotoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Padding="4"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <TextBlock Text="Foto dopo" FontWeight="SemiBold" Margin="0,12,0,7"/><Button Content="Aggiungi foto dopo" Command="{Binding AddAfterPhotosCommand}" HorizontalAlignment="Left" Padding="12,6"/>
                        <ItemsControl ItemsSource="{Binding AfterPhotos}" Margin="0,8,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,8,8"><StackPanel><Image Source="{Binding}" Width="100" Height="85" Stretch="UniformToFill"/><Button Content="Rimuovi" Command="{Binding DataContext.RemoveAfterPhotoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Padding="4"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0"><Button Content="Salva intervento" Command="{Binding SaveInterventionCommand}" Padding="16,8" Background="{DynamicResource MaterialDesign.Brush.Primary}" Foreground="White" BorderThickness="0"/><Button Content="Elimina" Command="{Binding DeleteInterventionCommand}" Margin="8,0,0,0" Padding="16,8"/><Button Content="Nuovo / Annulla" Command="{Binding NewInterventionCommand}" Margin="8,0,0,0" Padding="16,8"/></StackPanel>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="15" Padding="22" Margin="0,0,0,18">
                    <StackPanel>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Appuntamenti" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Command="{Binding NewAppointmentCommand}" Click="NewAppointment_Click" ToolTip="Nuovo appuntamento" Style="{StaticResource MaterialDesignToolButton}" Width="40" Height="40"><materialDesign:PackIcon Kind="Plus" Width="22" Height="22"/></Button>
                                <Button Command="{Binding EditAppointmentCommand}" CommandParameter="{Binding SelectedAppointment}" x:Name="EditAppointmentButton" IsEnabled="False" ToolTip="Modifica appuntamento selezionato" Style="{StaticResource MaterialDesignToolButton}" Width="40" Height="40"><materialDesign:PackIcon Kind="Pencil" Width="20" Height="20"/></Button>
                                <Button Command="{Binding DeleteAppointmentCommand}" x:Name="DeleteAppointmentButton" IsEnabled="False" ToolTip="Elimina appuntamento selezionato" Style="{StaticResource MaterialDesignToolButton}" Width="40" Height="40"><materialDesign:PackIcon Kind="Delete" Width="20" Height="20"/></Button>
                            </StackPanel>
                        </Grid>
                        <DataGrid ItemsSource="{Binding Appointments}" SelectedItem="{Binding SelectedAppointment}" SelectionChanged="Appointments_SelectionChanged" AutoGenerateColumns="False"
                                  Background="{DynamicResource MaterialDesign.Brush.Surface}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                  CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" MinHeight="100" MaxHeight="220" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Data" Binding="{Binding Date, StringFormat='{}{0:dd/MM/yyyy}'}" Width="Auto"/>
                                <DataGridTextColumn Header="Ora" Binding="{Binding Date, StringFormat='{}{0:HH:mm}'}" Width="Auto"/>
                                <DataGridTextColumn Header="Note" Binding="{Binding Notes}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                <Border x:Name="AppointmentDetailsPanel" Visibility="Collapsed" Background="White" CornerRadius="15" Padding="22" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Dettagli appuntamento" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,15"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,12">
                                <TextBlock Text="Data" Margin="0,0,0,5"/>
                                <DatePicker SelectedDate="{Binding AppointmentDate}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,12">
                                <TextBlock Text="Ora (HH:mm)" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding AppointmentTime, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Note" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding AppointmentNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="65" Padding="8"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                            <Button Content="Salva appuntamento" Command="{Binding SaveAppointmentCommand}" Padding="16,8" Background="{DynamicResource MaterialDesign.Brush.Primary}" Foreground="White" BorderThickness="0"/>
                            <Button Content="Elimina" Command="{Binding DeleteAppointmentCommand}" Margin="8,0,0,0" Padding="16,8"/>
                            <Button Content="Nuovo / Annulla" Command="{Binding NewAppointmentCommand}" Margin="8,0,0,0" Padding="16,8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>