<UserControl x:Class="BeautyStudio.Views.InterventionPhotosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#F7F5F6">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <Button Command="{Binding BackCommand}" HorizontalAlignment="Left" Padding="10,6" Margin="0,0,0,16">
                <TextBlock Text="← Torna alla scheda cliente"/>
            </Button>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Dettagli intervento" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CustomerName}" FontSize="16" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding EditCommand}"
                        Style="{StaticResource MaterialDesignToolButton}" Width="44" Height="44"
                        ToolTip="Modifica intervento / aggiungi o rimuovi foto"
                        AutomationProperties.Name="Modifica intervento, aggiungi o rimuovi foto">
                    <materialDesign:PackIcon Kind="Pencil" Width="23" Height="23"/>
                </Button>
            </Grid>
            <Border Background="White" Padding="20" Margin="0,0,0,18">
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="{Binding Intervention.Date, StringFormat='Data: {0:dd/MM/yyyy}'}" Margin="0,0,24,8"/>
                        <TextBlock Text="{Binding Intervention.Type.Name, StringFormat='Tipo: {0}'}" Margin="0,0,24,8"/>
                        <TextBlock Text="{Binding Intervention.Location.Name, StringFormat='Luogo: {0}'}" Margin="0,0,24,8"/>
                        <TextBlock Text="{Binding Intervention.Price, StringFormat='Prezzo: {0:C2}'}" Margin="0,0,24,8"/>
                        <TextBlock Text="{Binding Intervention.IsPaid, StringFormat='Pagato: {0}'}" Margin="0,0,24,8"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding NotesDisplay}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Padding="10,8" Margin="0,0,0,14" Background="{DynamicResource MaterialDesign.Brush.Surface}">
                <TextBlock Text="{Binding PhotoIntegrityMessage}" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"/>
            </Border>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" Padding="20" Margin="0,0,8,0" MinHeight="620">
                    <StackPanel>
                        <TextBlock Text="FOTO PRIMA" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,12"/>
                        <Button Command="{Binding OpenPhotoCommand}" CommandParameter="{Binding CurrentBeforePhoto.Path}" Padding="0" BorderThickness="0" Background="Transparent" Height="480" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalAlignment="Stretch">
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="{Binding CurrentBeforePhoto.Path}" Width="720" Height="480" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Viewbox>
                        </Button>
                        <TextBlock Text="Nessuna foto prima" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" HorizontalAlignment="Center" Margin="0,8">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding BeforePhotos.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,8">
                            <Button Command="{Binding PreviousBeforeCommand}" Style="{StaticResource MaterialDesignToolButton}" Width="40" Height="40"><materialDesign:PackIcon Kind="ChevronLeft" Width="22" Height="22"/></Button>
                            <TextBlock Text="{Binding BeforeCounter}" VerticalAlignment="Center" Margin="12,0"/>
                            <Button Command="{Binding NextBeforeCommand}" Style="{StaticResource MaterialDesignToolButton}" Width="40" Height="40"><materialDesign:PackIcon Kind="ChevronRight" Width="22" Height="22"/></Button>
                        </StackPanel>
                        <TextBlock Text="Data foto" Margin="0,8,0,3"/>
                        <DatePicker SelectedDate="{Binding CurrentBeforePhoto.Date, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Descrizione" Margin="0,8,0,3"/>
                        <TextBox Text="{Binding CurrentBeforePhoto.Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="55"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="White" Padding="20" Margin="8,0,0,0" MinHeight="620">
                    <StackPanel>
                        <TextBlock Text="FOTO DOPO" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,12"/>
                        <Button Command="{Binding OpenPhotoCommand}" CommandParameter="{Binding CurrentAfterPhoto.Path}" Padding="0" BorderThickness="0" Background="Transparent" Height="480" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalAlignment="Stretch">
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="{Binding CurrentAfterPhoto.Path}" Width="720" Height="480" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Viewbox>
                        </Button>
                        <TextBlock Text="Nessuna foto dopo" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" HorizontalAlignment="Center" Margin="0,8">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding AfterPhotos.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,8">
                            <Button Command="{Binding PreviousAfterCommand}" Style="{StaticResource MaterialDesignToolButton}" Width="40" Height="40"><materialDesign:PackIcon Kind="ChevronLeft" Width="22" Height="22"/></Button>
                            <TextBlock Text="{Binding AfterCounter}" VerticalAlignment="Center" Margin="12,0"/>
                            <Button Command="{Binding NextAfterCommand}" Style="{StaticResource MaterialDesignToolButton}" Width="40" Height="40"><materialDesign:PackIcon Kind="ChevronRight" Width="22" Height="22"/></Button>
                        </StackPanel>
                        <TextBlock Text="Data foto" Margin="0,8,0,3"/>
                        <DatePicker SelectedDate="{Binding CurrentAfterPhoto.Date, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Descrizione" Margin="0,8,0,3"/>
                        <TextBox Text="{Binding CurrentAfterPhoto.Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="55"/>
                    </StackPanel>
                </Border>
            </Grid>
            <WrapPanel Margin="0,16,0,20">
                <Button Content="Salva date e descrizioni foto" Command="{Binding SavePhotoMetadataCommand}" HorizontalAlignment="Left" Padding="16,8" Margin="0,0,10,8" MinHeight="38"/>
                <Button Command="{Binding ExportComparisonCommand}" Padding="16,8" Margin="0,0,0,8" MinHeight="38">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileExport" Margin="0,0,7,0"/>
                        <TextBlock Text="Esporta confronto prima/dopo"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" TextWrapping="Wrap" Margin="0,0,0,16"/>
            <Border Background="White" Padding="18">
                <StackPanel>
                    <TextBlock Text="Storico modifiche e pagamenti" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border BorderBrush="#E5E5E5" BorderThickness="0,0,0,1" Padding="0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding ChangedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Action}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Details}" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Nessuna modifica registrata." Foreground="{DynamicResource MaterialDesign.Brush.Secondary}">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding History.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>