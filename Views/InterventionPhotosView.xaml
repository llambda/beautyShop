<UserControl x:Class="BeautyStudio.Views.InterventionPhotosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#F7F5F6">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <Button Command="{Binding BackCommand}" HorizontalAlignment="Left" Padding="10,6" Margin="0,0,0,16">
                <TextBlock Text="← Torna alla scheda cliente"/>
            </Button>
            <TextBlock Text="Dettagli intervento" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding CustomerName}" FontSize="16" Margin="0,5,0,16"/>
            <Border Background="White" Padding="20" Margin="0,0,0,18">
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="{Binding Intervention.Date, StringFormat='Data: {0:dd/MM/yyyy}'}" Margin="0,0,24,8"/>
                        <TextBlock Text="{Binding Intervention.Type.Name, StringFormat='Tipo: {0}'}" Margin="0,0,24,8"/>
                        <TextBlock Text="{Binding Intervention.Location.Name, StringFormat='Luogo: {0}'}" Margin="0,0,24,8"/>
                        <TextBlock Text="{Binding Intervention.Price, StringFormat='Prezzo: {0:C2}'}" Margin="0,0,24,8"/>
                        <TextBlock Text="{Binding Intervention.IsPaid, StringFormat='Pagato: {0}'}" Margin="0,0,24,8"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding Intervention.Notes, TargetNullValue='Nessuna nota'}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <Button Content="Modifica intervento / aggiungi o rimuovi foto" Command="{Binding EditCommand}" HorizontalAlignment="Left" Padding="14,7" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" Padding="18" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Confronto prima / dopo" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding PhotoPairs}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="PRIMA" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Button Command="{Binding DataContext.OpenPhotoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding BeforePhoto.Path}" Padding="0" BorderThickness="0">
                                        <Image Source="{Binding BeforePhoto.Path}" Height="220" Stretch="Uniform"/>
                                    </Button>
                                    
                                    <TextBlock Text="Data foto" Margin="0,8,0,3"/>
                                    <DatePicker SelectedDate="{Binding BeforePhoto.Date, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Descrizione (facoltativa)" Margin="0,8,0,3"/>
                                    <TextBox Text="{Binding BeforePhoto.Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="DOPO" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Button Command="{Binding DataContext.OpenPhotoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding AfterPhoto.Path}" Padding="0" BorderThickness="0">
                                        <Image Source="{Binding AfterPhoto.Path}" Height="220" Stretch="Uniform"/>
                                    </Button>
                                    
                                    <TextBlock Text="Data foto" Margin="0,8,0,3"/>
                                    <DatePicker SelectedDate="{Binding AfterPhoto.Date, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Descrizione (facoltativa)" Margin="0,8,0,3"/>
                                    <TextBox Text="{Binding AfterPhoto.Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Le foto vengono abbinate nell'ordine in cui sono state caricate." Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Button Content="Salva date e descrizioni foto" Command="{Binding SavePhotoMetadataCommand}" HorizontalAlignment="Left" Padding="16,8" Margin="0,16,0,20"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" TextWrapping="Wrap" Margin="0,0,0,16"/>
            <Border Background="White" Padding="18">
                <StackPanel>
                    <TextBlock Text="Storico modifiche e pagamenti" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border BorderBrush="#E5E5E5" BorderThickness="0,0,0,1" Padding="0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding ChangedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Action}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Details}" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Nessuna modifica registrata." Foreground="{DynamicResource MaterialDesign.Brush.Secondary}">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding History.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>