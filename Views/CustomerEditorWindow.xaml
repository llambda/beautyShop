<Window x:Class="BeautyStudio.Views.CustomerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding WindowTitle}"
        Width="760"
        Height="780"
        MinWidth="680"
        MinHeight="700"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        WindowStartupLocation="CenterOwner"
        Background="#F7F5F6">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITOLO -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{Binding WindowTitle}"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>

            <TextBlock Text="Inserisci i dati anagrafici del cliente"
                       Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- CONTENUTO -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- FOTO -->
                <StackPanel Grid.Column="0"
                            Margin="0,0,20,0">

                    <Border Width="160"
                            Height="190"
                            Background="#F0E5EA"
                            CornerRadius="12"
                            ClipToBounds="True">

                        <Grid>
                            <Image Source="{Binding PhotoPath}"
                                   Stretch="UniformToFill"/>

                            <TextBlock Text="Nessuna foto"
                                       Foreground="#967D88"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PhotoPath}"
                                                         Value="{x:Null}">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PhotoPath}"
                                                         Value="">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Button Content="Scegli foto"
                            Command="{Binding SelectPhotoCommand}"
                            Margin="0,12,0,0"
                            Background="{DynamicResource MaterialDesign.Brush.Primary}"
                            Foreground="White"
                            Height="40" MinHeight="38" Padding="12,8"/>

                </StackPanel>

                <!-- DATI -->
                <StackPanel Grid.Column="1">

                    <TextBlock Text="Nome *"/>
                    <TextBox Text="{Binding FirstName,
                                    UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,5,0,15"
                             Padding="8"/>

                    <TextBlock Text="Cognome *"/>
                    <TextBox Text="{Binding LastName,
                                    UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,5,0,15"
                             Padding="8"/>

                    <TextBlock Text="Data di nascita"/>
                    <DatePicker SelectedDate="{Binding BirthDate}"
                                Margin="0,5,0,15"/>

                    <TextBlock Text="Telefono"/>
                    <TextBox Text="{Binding Phone,
                                    UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,5,0,15"
                             Padding="8"/>

                    <TextBlock Text="Email"/>
                    <TextBox Text="{Binding Email,
                                    UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,5,0,15"
                             Padding="8"/>

                    <TextBlock Text="Indirizzo"/>
                    <TextBox Text="{Binding Address,
                                    UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,5,0,15"
                             Padding="8"/>

                    <TextBlock Text="Allergie" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Allergies, UpdateSourceTrigger=PropertyChanged}"
                             Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" Margin="0,5,0,15" Padding="8"/>

                    <TextBlock Text="Sensibilità e intolleranze" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Sensitivities, UpdateSourceTrigger=PropertyChanged}"
                             Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" Margin="0,5,0,15" Padding="8"/>

                    <TextBlock Text="Note personali (uso interno)" FontWeight="SemiBold"/>
                    <TextBlock Text="Annotazioni riservate alla gestione del cliente, separate dalle note dei singoli appuntamenti e interventi."
                               Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,4"/>
                    <TextBox Text="{Binding Notes,
                                    UpdateSourceTrigger=PropertyChanged}"
                             Height="90"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,5,0,15"
                             Padding="8"/>


                    <TextBlock Text="Consenso informato firmato (PDF)" FontWeight="SemiBold" Margin="0,5,0,5"/>
                    <TextBlock Text="{Binding ConsentFormPath, TargetNullValue='Nessun consenso caricato'}"
                               Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Button Content="Carica PDF" Command="{Binding SelectConsentFormCommand}"
                                Padding="12,8" Margin="0,0,8,0" MinHeight="38"/>
                        <Button Content="Rimuovi" Command="{Binding RemoveConsentFormCommand}"
                                Padding="12,8" MinHeight="38"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ConsentAcquiredAt, StringFormat='Data acquisizione: {0:dd/MM/yyyy HH:mm}', TargetNullValue='Data acquisizione non disponibile'}"
                               Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#C62828"
                               TextWrapping="Wrap"
                               Margin="0,5,0,10"/>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- PULSANTI -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="Annulla"
                    Command="{Binding CancelCommand}"
                    Margin="0,0,10,0"
                    Padding="20,10"
                    MinWidth="130"
                    Height="42"/>


            <Button Content="Salva cliente"
        Command="{Binding SaveCommand}"
        IsEnabled="{Binding IsSaving,
                    Converter={StaticResource InverseBooleanConverter}}"
        Background="{DynamicResource MaterialDesign.Brush.Primary}"
        Foreground="White"
        Padding="20,10"
        MinWidth="130"
        Height="42"/>


        </StackPanel>
    </Grid>
</Window>
