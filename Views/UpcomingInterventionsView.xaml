<UserControl x:Class="BeautyStudio.Views.UpcomingInterventionsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
 Background="#F7F5F6">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="0,0,0,18">
   <TextBlock Text="Prossimi appuntamenti" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
   <TextBlock Text="Elenco degli appuntamenti programmati da adesso in avanti, in ordine cronologico." FontSize="13" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" Margin="0,5,0,0"/>
  </StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,12">
   <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"/>
   <Button HorizontalAlignment="Right" Command="{Binding RefreshCommand}" Style="{StaticResource MaterialDesignToolButton}" Width="40" Height="40" ToolTip="Aggiorna elenco">
    <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20"/>
   </Button>
  </Grid>
  <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="12">
   <DataGrid ItemsSource="{Binding Appointments}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="48">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Data" Binding="{Binding Date, StringFormat='{}{0:dd/MM/yyyy}'}" Width="125"/>
     <DataGridTextColumn Header="Ora" Binding="{Binding Date, StringFormat='{}{0:HH:mm}'}" Width="85"/>
     <DataGridTextColumn Header="Cliente" Width="2*">
      <DataGridTextColumn.Binding>
       <MultiBinding StringFormat="{}{0} {1}"><Binding Path="Customer.FirstName"/><Binding Path="Customer.LastName"/></MultiBinding>
      </DataGridTextColumn.Binding>
     </DataGridTextColumn>
     <DataGridTextColumn Header="Tipo di intervento" Binding="{Binding InterventionType.Name}" Width="2*"/>
     <DataGridTextColumn Header="Luogo" Binding="{Binding Location.Name}" Width="2*"/>
     <DataGridTextColumn Header="Stato" Binding="{Binding Status}" Width="*"/>
     <DataGridTextColumn Header="Note" Binding="{Binding Notes}" Width="3*"/>
     <DataGridTemplateColumn Header="Azioni" Width="220">
      <DataGridTemplateColumn.CellTemplate>
       <DataTemplate>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
         <Button Content="Modifica" Command="{Binding DataContext.EditAppointmentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="9,8" Margin="0,0,5,0" ToolTip="Modifica appuntamento" MinHeight="38"/>
         <Button Content="Segna eseguito" Command="{Binding DataContext.MarkAppointmentAsExecutedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="9,8" ToolTip="Registra l'appuntamento nello storico interventi" MinHeight="38"/>
        </StackPanel>
       </DataTemplate>
      </DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
    </DataGrid.Columns>
   </DataGrid>
  </Border>
 </Grid>
</UserControl>