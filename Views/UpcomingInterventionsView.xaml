<UserControl x:Class="BeautyStudio.Views.UpcomingInterventionsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
 Background="#F7F5F6">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="0,0,0,18">
   <TextBlock Text="Prossimi interventi" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
   <TextBlock Text="Elenco degli interventi programmati da oggi in avanti, in ordine di data." FontSize="13" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" Margin="0,5,0,0"/>
  </StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,12">
   <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"/>
   <Button HorizontalAlignment="Right" Command="{Binding RefreshCommand}" Style="{StaticResource MaterialDesignToolButton}" Width="40" Height="40" ToolTip="Aggiorna elenco">
    <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20"/>
   </Button>
  </Grid>
  <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="12">
   <DataGrid ItemsSource="{Binding Interventions}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="48">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Data" Binding="{Binding Date, StringFormat='{}{0:dd/MM/yyyy}'}" Width="125"/>
     <DataGridTextColumn Header="Ora" Binding="{Binding Date, StringFormat='{}{0:HH:mm}'}" Width="85"/>
     <DataGridTextColumn Header="Cliente" Width="2*">
      <DataGridTextColumn.Binding>
       <MultiBinding StringFormat="{}{0} {1}"><Binding Path="Customer.FirstName"/><Binding Path="Customer.LastName"/></MultiBinding>
      </DataGridTextColumn.Binding>
     </DataGridTextColumn>
     <DataGridTextColumn Header="Tipo intervento" Binding="{Binding Type.Name}" Width="2*"/>
     <DataGridTextColumn Header="Luogo" Binding="{Binding Location.Name}" Width="2*"/>
     <DataGridTextColumn Header="Note" Binding="{Binding Notes}" Width="3*"/>
    </DataGrid.Columns>
   </DataGrid>
  </Border>
 </Grid>
</UserControl>