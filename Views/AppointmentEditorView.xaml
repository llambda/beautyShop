<UserControl x:Class="BeautyStudio.Views.AppointmentEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#F7F5F6">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <StackPanel MaxWidth="800" HorizontalAlignment="Stretch">
                <Button Command="{Binding Parent.CancelEditorCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="20" Height="20"/>
                        <TextBlock Text="Torna alla scheda cliente" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>

                <TextBlock Text="{Binding Parent.Customer.FirstName}"
                           FontSize="14"
                           Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                           Margin="0,12,0,4"/>
                <TextBlock Text="Dettagli appuntamento"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Margin="0,0,0,20"/>

                <Border Background="White" CornerRadius="15" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Data" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding Parent.AppointmentDate}" Margin="0,0,0,16"/>

                        <TextBlock Text="Orario di inizio" Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding Parent.AppointmentHourOptions}"
                                      SelectedItem="{Binding Parent.AppointmentHour}"
                                      ItemStringFormat="{}{0:00}"
                                      MinHeight="42"
                                      Padding="8"
                                      ToolTip="Seleziona l'ora"/>
                            <TextBlock Grid.Column="1" Text=":" FontSize="22"
                                       VerticalAlignment="Center" Margin="10,0"/>
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding Parent.AppointmentMinuteOptions}"
                                      SelectedItem="{Binding Parent.AppointmentMinute}"
                                      ItemStringFormat="{}{0:00}"
                                      MinHeight="42"
                                      Padding="8"
                                      ToolTip="Seleziona i minuti, a intervalli di 5"/>
                        </Grid>

                        <TextBlock Text="Durata (minuti)" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding Parent.AppointmentDurationOptions}"
                                  SelectedItem="{Binding Parent.AppointmentDurationMinutes}"
                                  Margin="0,0,0,16"/>

                        <TextBlock Text="Luogo" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding Parent.Locations}"
                                  SelectedItem="{Binding Parent.SelectedAppointmentLocation}"
                                  DisplayMemberPath="Name" Margin="0,0,0,16"/>

                        <TextBlock Text="Tipo di intervento" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding Parent.Types}"
                                  SelectedItem="{Binding Parent.SelectedAppointmentType}"
                                  DisplayMemberPath="Name" Margin="0,0,0,16"/>

                        <TextBlock Text="Stato appuntamento" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding Parent.AppointmentStatuses}"
                                  SelectedItem="{Binding Parent.SelectedAppointmentStatus}"
                                  Margin="0,0,0,16"/>

                        <TextBlock Text="Note" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Parent.AppointmentNotes, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" Padding="8"/>

                        <TextBlock Text="{Binding Parent.StatusMessage}"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                   Margin="0,16,0,0" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="Salva appuntamento"
                                    Command="{Binding Parent.SaveAppointmentCommand}"
                                    Padding="18,9"
                                    Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                    Foreground="White" BorderThickness="0" MinHeight="38"/>
                            <Button Content="Elimina"
                                    Command="{Binding Parent.DeleteAppointmentCommand}"
                                    Margin="8,0,0,0" Padding="18,9" MinHeight="38"/>
                            <Button Content="Annulla"
                                    Command="{Binding Parent.CancelEditorCommand}"
                                    Margin="8,0,0,0" Padding="18,9" MinHeight="38"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
