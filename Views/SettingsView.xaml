<UserControl x:Class="BeautyStudio.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:BeautyStudio.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Impostazioni" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,20"/>

            <Border Background="{DynamicResource MaterialDesign.Brush.Surface}" CornerRadius="12" Padding="22" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Aspetto" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Palette colori" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="Scegli una palette. I pulsanti Primary e Secondary impostano separatamente i colori dell'app."
                               TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <ItemsControl ItemsSource="{Binding PrimaryPalettes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="145" Margin="0,0,8,8" CornerRadius="3"
                                        Background="{DynamicResource MaterialDesign.Brush.SurfaceContainer}"
                                        BorderBrush="{DynamicResource MaterialDesign.Brush.OutlineVariant}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="11" Margin="6,4"
                                                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="Primary" Tag="{Binding Hex}"
                                                    Click="PrimaryPalette_Click" MinHeight="34" Padding="8,8" BorderThickness="0"
                                                    Background="{Binding Hex}" Foreground="{Binding PrimaryText}"
                                                    ToolTip="Imposta colore primario"/>
                                            <Button Grid.Column="1" Content="Secondary" Tag="{Binding SecondaryHex}"
                                                    Click="SecondaryPalette_Click" MinHeight="34" Padding="8,8" BorderThickness="0"
                                                    Background="{Binding SecondaryHex}" Foreground="{Binding SecondaryText}"
                                                    ToolTip="Imposta colore secondario"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource MaterialDesign.Brush.Surface}" CornerRadius="12" Padding="22" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Backup ed esportazione" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Proteggi i dati e crea una copia esportabile dell'elenco clienti." TextWrapping="Wrap" Margin="0,5,0,14"/>
                    <WrapPanel>
                        <Button Command="{Binding CreateBackupCommand}" Padding="16,9" Margin="0,0,10,10">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="BackupRestore" Width="18" Height="18"/>
                                <TextBlock Text="Crea backup" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RestoreBackupCommand}" Padding="16,9" Margin="0,0,10,10">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Restore" Width="18" Height="18"/>
                                <TextBlock Text="Ripristina backup" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ExportCustomersCommand}" Padding="16,9" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDelimited" Width="18" Height="18"/>
                                <TextBlock Text="Esporta clienti CSV" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock Text="{Binding DataManagementStatus}" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource MaterialDesign.Brush.Surface}" CornerRadius="12" Padding="22" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Luoghi intervento" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Seleziona un luogo per modificarlo o eliminarlo." TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding AddLocationCommand}" ToolTip="Aggiungi luogo" Style="{StaticResource MaterialDesignToolButton}" Width="40" Height="40">
                                <materialDesign:PackIcon Kind="Plus" Width="22" Height="22"/>
                            </Button>
                            <Button Command="{Binding EditLocationCommand}" x:Name="EditLocationButton" IsEnabled="False" ToolTip="Modifica luogo selezionato" Style="{StaticResource MaterialDesignToolButton}" Width="40" Height="40">
                                <materialDesign:PackIcon Kind="Pencil" Width="20" Height="20"/>
                            </Button>
                            <Button Command="{Binding DeleteLocationCommand}" x:Name="DeleteLocationButton" IsEnabled="False" ToolTip="Elimina luogo selezionato" Style="{StaticResource MaterialDesignToolButton}" Width="40" Height="40">
                                <materialDesign:PackIcon Kind="Delete" Width="20" Height="20"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <DataGrid ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}" SelectionChanged="Locations_SelectionChanged" AutoGenerateColumns="False"
                              Background="{DynamicResource MaterialDesign.Brush.Surface}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                              CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" MinHeight="130" MaxHeight="240"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Indirizzo" Binding="{Binding Address}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource MaterialDesign.Brush.Surface}" CornerRadius="12" Padding="22">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Tipi di intervento" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Gestisci le categorie di trattamento disponibili." TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding AddInterventionTypeCommand}" ToolTip="Aggiungi tipo" Style="{StaticResource MaterialDesignToolButton}" Width="40" Height="40">
                                <materialDesign:PackIcon Kind="Plus" Width="22" Height="22"/>
                            </Button>
                            <Button Command="{Binding EditInterventionTypeCommand}" x:Name="EditTypeButton" IsEnabled="False" ToolTip="Modifica tipo selezionato" Style="{StaticResource MaterialDesignToolButton}" Width="40" Height="40">
                                <materialDesign:PackIcon Kind="Pencil" Width="20" Height="20"/>
                            </Button>
                            <Button Command="{Binding DeleteInterventionTypeCommand}" x:Name="DeleteTypeButton" IsEnabled="False" ToolTip="Elimina tipo selezionato" Style="{StaticResource MaterialDesignToolButton}" Width="40" Height="40">
                                <materialDesign:PackIcon Kind="Delete" Width="20" Height="20"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <DataGrid ItemsSource="{Binding InterventionTypes}" SelectedItem="{Binding SelectedInterventionType}" SelectionChanged="Types_SelectionChanged" AutoGenerateColumns="False"
                              Background="{DynamicResource MaterialDesign.Brush.Surface}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                              CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" MinHeight="130" MaxHeight="240"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Descrizione" Binding="{Binding Description}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource MaterialDesign.Brush.Surface}" CornerRadius="12" Padding="22" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="Versione e aggiornamenti" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CurrentVersion, StringFormat='Versione installata: {0}'}" Margin="0,6,0,10"/>
                    <WrapPanel>
                        <Button Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding IsCheckingUpdates, Converter={StaticResource InverseBooleanConverter}}" Padding="16,9" Margin="0,0,10,8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Update" Width="18" Height="18"/>
                                <TextBlock Text="Controlla aggiornamenti" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenLatestReleaseCommand}" Padding="16,9" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="OpenInNew" Width="18" Height="18"/>
                                <TextBlock Text="Apri pagina versioni" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock Text="{Binding UpdateStatus}" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" TextWrapping="Wrap"/>
                    <TextBlock Text="Il programma verifica le release pubblicate su GitHub. L'installazione resta manuale per evitare sostituzioni non sicure dei file in uso." Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
