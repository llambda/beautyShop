<UserControl x:Class="BeautyStudio.Views.GalleryView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="24">
   <Grid Margin="0,0,0,18">
    <StackPanel>
     <TextBlock Text="Galleria fotografica" FontSize="28" FontWeight="SemiBold"/>
     <TextBlock Text="Rivedi e confronta le fotografie degli interventi." Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" Margin="0,5,0,0"/>
    </StackPanel>
    <Button Command="{Binding RefreshCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,7">
     <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Refresh" Margin="0,0,6,0"/><TextBlock Text="Aggiorna"/></StackPanel>
    </Button>
   </Grid>
   <Grid Margin="0,0,0,16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Cerca cliente o trattamento" Margin="0,0,10,0" MinHeight="42"/>
    <ComboBox Grid.Column="1" ItemsSource="{Binding TreatmentTypes}" SelectedItem="{Binding SelectedTreatment}" MinHeight="42"/>
   </Grid>
   <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" Margin="0,0,0,12"/>
   <ItemsControl ItemsSource="{Binding FilteredItems}">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
     <DataTemplate>
      <Border Background="{DynamicResource MaterialDesign.Brush.Surface}" BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}" BorderThickness="1" Padding="12" Margin="0,0,14,14" Width="300">
       <StackPanel>
        <Border Height="190" Background="{DynamicResource MaterialDesign.Brush.SurfaceVariant}" ClipToBounds="True">
         <Image Source="{Binding PreviewPhotoPath, Converter={StaticResource PhotoPathToImageConverter}}" Stretch="UniformToFill"/>
        </Border>
        <TextBlock Text="{Binding CustomerName}" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,2"/>
        <TextBlock Text="{Binding TreatmentName}" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"/>
        <TextBlock Text="{Binding Intervention.Date, StringFormat='{}{0:dd/MM/yyyy}'}" Margin="0,5,0,0"/>
        <TextBlock Text="{Binding PhotoCountLabel}" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" Margin="0,3,0,10"/>
        <Button Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalAlignment="Stretch" Padding="12,8">
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <materialDesign:PackIcon Kind="Compare" Margin="0,0,7,0"/>
          <TextBlock Text="Apri confronto prima/dopo"/>
         </StackPanel>
        </Button>
       </StackPanel>
      </Border>
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>
   <TextBlock Text="Nessun intervento corrisponde ai filtri selezionati." Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" Margin="0,12,0,0">
    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding FilteredItems.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
  </StackPanel>
 </ScrollViewer>
</UserControl>